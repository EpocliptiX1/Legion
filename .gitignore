# Contains plaintext passwords for generated Anikoto-commenter accounts - never commit this
Backend/AnikotoCommentUserInfo.txt

# AES key that encrypts every /api/m3u8-proxy and /api/proxy-stream target URL - leaking this
# defeats that protection entirely, same as a leaked password. Auto-generated on first run.
Backend/proxy_token.key

# Shared secret between middleware.js and server.js - replaces the old hardcoded default.
# Auto-generated on first run by either process.
Backend/middleware_secret.key

# HMAC key that signs the aniko_sid session cookie - leaking this lets a client forge a
# "valid" session id of its choosing. Auto-generated on first run.
Backend/session_secret.key

# Local playback-integrity honeypot audit trail. It contains client IP addresses by design.
Backend/security-honeypot-events.jsonl

# Signs/verifies every login session JWT. Used to run on a hardcoded 'dev-secret-change-me'
# fallback (pentest, 2026-08-17 round 3, confirmed live) - leaking this key lets anyone forge
# a valid session for any userUID/userEmail with no password. Auto-generated on first run.
Backend/jwt_secret.key
